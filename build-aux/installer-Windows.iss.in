; Inno Setup script for the Windows x64 plugin installer.
;
; This is a template: .github/scripts/Package-Windows.ps1 substitutes the @TOKEN@
; placeholders and compiles the result with ISCC. Do not run ISCC on this file directly.
;
; WHERE OBS ACTUALLY LOOKS ON WINDOWS. Not %APPDATA%. OBS builds its one external
; plugin search path in AddExtraModulePaths() (frontend/widgets/OBSBasic.cpp):
;
;     #if defined(_WIN32)
;         GetProgramDataPath(base_module_dir, ..., "obs-studio/plugins/%module%");
;     #elif defined(__APPLE__) / #else
;         GetAppConfigPath(base_module_dir, ..., "obs-studio/plugins/%module%");
;
; then adds "<that>/bin/64bit" and "<that>/data". So the per-user config directory is
; a mac/Linux convention; on Windows the root is %ProgramData%. 1.3.0 installed to
; %APPDATA%\obs-studio\plugins\castbeacon, which OBS never scans - it produced no log
; line at all, not even a "skipping module". 1.3.1 installs to ProgramData.
;
; UPGRADE FROM 1.2.0 (the "castpilot" module name). OBS loads EVERY module folder it
; finds, so a leftover castpilot folder next to castbeacon means two modules, two
; shadow outputs and one relay path - they evict each other every couple of seconds.
; This installer deletes the obsolete folders before it copies anything, in BOTH roots
; (a hand-made ProgramData install is exactly what resurrected the old plugin on the
; dev box), and offers to remove copies inside OBS's own program folder.
;
; What is deliberately NOT touched: plugin_config\castpilot\settings.json. That is the
; app's settings file, and the renamed plugin still reads it as a fallback for app
; versions that only know the old path. Deleting it would silently reset the operator's
; overflow encode settings. Note that plugin_config genuinely does live under %APPDATA%
; - OBS derives it from the module's FILE NAME and its own config root, not from where
; the DLL sits (obs_module_get_config_path, libobs/obs-module.c), so moving the install
; to ProgramData does not move the settings.

#define PluginName        "@PLUGIN_NAME@"
#define PluginDisplayName "@PLUGIN_DISPLAY_NAME@"
#define PluginVersion     "@PLUGIN_VERSION@"
#define PluginAuthor      "@PLUGIN_AUTHOR@"
#define PayloadDir        "@PAYLOAD_DIR@"

; The module name this plugin shipped under before 1.3.0.
#define LegacyPluginName  "castpilot"

; Kept without braces so it can be spelled both as an Inno constant-escaped AppId and
; as a registry key name below, from one definition.
#define AppGuidBare       "113E453B-E0EA-45A3-AABD-BF093378B668"

[Setup]
; Keep this GUID stable across releases so upgrades replace rather than stack.
AppId={{{#AppGuidBare}}
AppName={#PluginDisplayName}
AppVersion={#PluginVersion}
AppVerName={#PluginDisplayName} {#PluginVersion}
AppPublisher={#PluginAuthor}
VersionInfoVersion={#PluginVersion}
VersionInfoCompany={#PluginAuthor}
VersionInfoDescription={#PluginDisplayName} installer
DefaultDirName={commonappdata}\obs-studio\plugins\{#PluginName}
UninstallDisplayName={#PluginDisplayName} {#PluginVersion}
; The install location is fixed by OBS convention - letting the user move it
; would simply produce a plugin OBS never loads.
DisableDirPage=yes
; The AppId is stable, so an earlier install has recorded its own directory - and for
; 1.3.0 that directory is the wrong one. Without this, Setup would reinstall straight
; back into %APPDATA% and the fix would do nothing. It also covers the dev box's
; hand-moved copy, which has no recorded directory at all.
UsePreviousAppDir=no
DisableProgramGroupPage=yes
; ProgramData is a machine-wide location. Its default ACL lets a standard user CREATE
; files, but not overwrite or delete files another account created - which is exactly
; what an upgrade has to do. Rather than install fine today and fail on the next
; upgrade (or on any machine where OBS was set up by a different account), require
; elevation up front and say so in the release notes.
PrivilegesRequired=admin
OutputDir=@OUTPUT_DIR@
OutputBaseFilename=@OUTPUT_BASENAME@
Compression=lzma2
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[InstallDelete]
; Obsolete module folders, in both roots. All of these run before any file is copied.
;
; ProgramData\castpilot is the one that actually matters: OBS scans it, so a hand-made
; dev install there keeps the pre-rename module alive alongside this one.
Type: filesandordirs; Name: "{commonappdata}\obs-studio\plugins\{#LegacyPluginName}"
; The %APPDATA% pair is inert on Windows (OBS never looks there) but confusing, and
; 1.3.0's installer left a castbeacon folder there on every machine that ran it.
; Best-effort: if Setup was elevated with a different account, {userappdata} is that
; account's - a miss here costs nothing because nothing loads from it.
Type: filesandordirs; Name: "{userappdata}\obs-studio\plugins\{#LegacyPluginName}"
Type: filesandordirs; Name: "{userappdata}\obs-studio\plugins\{#PluginName}"
; Overwrite a hand-placed copy cleanly rather than merging into it. unins*.* covers a
; stray uninstaller that came along with a folder someone moved here by hand; Setup
; writes its own afterwards.
Type: filesandordirs; Name: "{app}\bin"
Type: filesandordirs; Name: "{app}\data"
Type: files; Name: "{app}\unins*.*"

[Registry]
; 1.3.0 installed per-user, so its Add/Remove entry lives in HKCU and an elevated
; (HKLM) install will not replace it - it would dangle, pointing at the folder deleted
; above. Same AppId, so this one key covers both 1.2.0 and 1.3.0.
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Uninstall\{{{#AppGuidBare}}_is1"; ValueType: none; Flags: deletekey

[Files]
Source: "{#PayloadDir}\bin\64bit\{#PluginName}.dll"; DestDir: "{app}\bin\64bit"; Flags: ignoreversion
Source: "{#PayloadDir}\data\*"; DestDir: "{app}\data"; Flags: ignoreversion recursesubdirs createallsubdirs

[UninstallDelete]
; Parity with [Files]: everything this installer created, and nothing else. The
; operator's plugin_config settings survive an uninstall on purpose.
Type: filesandordirs; Name: "{app}\bin"
Type: filesandordirs; Name: "{app}\data"
Type: dirifempty; Name: "{app}"

[Code]
{ ---------------------------------------------------------------------------
  Pre-install checks. Two ways an upgrade can leave OBS loading two modules:

  1. OBS is open, so the old DLL is locked and the cleanup half-fails.
  2. Someone hand-copied the plugin into OBS's own program folder. [InstallDelete]
     covers the two plugin roots OBS scans; it cannot cover an in-tree copy, because
     that path is not knowable at compile time. So find it, name it, and - now that
     Setup runs elevated - offer to remove it instead of only complaining.
  --------------------------------------------------------------------------- }

function IsObsRunning(): Boolean;
var
  Locator, Service, Items: Variant;
begin
  Result := False;
  try
    Locator := CreateOleObject('WbemScripting.SWbemLocator');
    Service := Locator.ConnectServer('.', 'root\CIMV2');
    Items := Service.ExecQuery('SELECT ProcessId FROM Win32_Process WHERE Name = "obs64.exe"');
    Result := Items.Count > 0;
  except
    { WMI unavailable (locked down box). Don't invent a state - fall through and let
      Inno's own in-use file detection handle whatever it can. }
    Result := False;
  end;
end;

{ Where OBS itself is installed, so its in-tree plugin folder can be checked. OBS's
  installer records its directory in HKLM\SOFTWARE\OBS Studio; the default locations
  are the fallback. Empty string = OBS not found, nothing to check. }
function ObsProgramDir(): String;
var
  Root: Integer;
  Dir: String;
begin
  Result := '';

  if IsWin64 then
    Root := HKLM64
  else
    Root := HKEY_LOCAL_MACHINE;

  if RegQueryStringValue(Root, 'SOFTWARE\OBS Studio', '', Dir) and (Dir <> '') then
  begin
    Result := RemoveBackslashUnlessRoot(Dir);
    Exit;
  end;

  if DirExists(ExpandConstant('{commonpf64}\obs-studio')) then
    Result := ExpandConstant('{commonpf64}\obs-studio')
  else if DirExists(ExpandConstant('{commonpf32}\obs-studio')) then
    Result := ExpandConstant('{commonpf32}\obs-studio');
end;

{ Copies of either module name sitting inside OBS's own program folder. Count is
  returned; Paths is filled with one path per line for display. }
function InTreeCopies(var Paths: String): Integer;
var
  ObsDir: String;
  Candidates: array[0..3] of String;
  IsDir: array[0..3] of Boolean;
  I, Found: Integer;
begin
  Paths := '';
  Found := 0;

  ObsDir := ObsProgramDir();
  if ObsDir = '' then
  begin
    Result := 0;
    Exit;
  end;

  Candidates[0] := ObsDir + '\obs-plugins\64bit\{#LegacyPluginName}.dll';  IsDir[0] := False;
  Candidates[1] := ObsDir + '\obs-plugins\64bit\{#PluginName}.dll';        IsDir[1] := False;
  Candidates[2] := ObsDir + '\data\obs-plugins\{#LegacyPluginName}';       IsDir[2] := True;
  Candidates[3] := ObsDir + '\data\obs-plugins\{#PluginName}';             IsDir[3] := True;

  for I := 0 to 3 do
  begin
    if IsDir[I] then
    begin
      if DirExists(Candidates[I]) then
      begin
        Paths := Paths + '    ' + Candidates[I] + '\' + #13#10;
        Found := Found + 1;
      end;
    end
    else
    begin
      if FileExists(Candidates[I]) then
      begin
        Paths := Paths + '    ' + Candidates[I] + #13#10;
        Found := Found + 1;
      end;
    end;
  end;

  Result := Found;
end;

function DeleteInTreeCopies(): Boolean;
var
  ObsDir: String;
  Ok: Boolean;
begin
  ObsDir := ObsProgramDir();
  if ObsDir = '' then
  begin
    Result := True;
    Exit;
  end;

  Ok := True;

  if FileExists(ObsDir + '\obs-plugins\64bit\{#LegacyPluginName}.dll') then
    if not DeleteFile(ObsDir + '\obs-plugins\64bit\{#LegacyPluginName}.dll') then Ok := False;
  if FileExists(ObsDir + '\obs-plugins\64bit\{#PluginName}.dll') then
    if not DeleteFile(ObsDir + '\obs-plugins\64bit\{#PluginName}.dll') then Ok := False;
  if DirExists(ObsDir + '\data\obs-plugins\{#LegacyPluginName}') then
    if not DelTree(ObsDir + '\data\obs-plugins\{#LegacyPluginName}', True, True, True) then Ok := False;
  if DirExists(ObsDir + '\data\obs-plugins\{#PluginName}') then
    if not DelTree(ObsDir + '\data\obs-plugins\{#PluginName}', True, True, True) then Ok := False;

  Result := Ok;
end;

function InitializeSetup(): Boolean;
begin
  Result := True;

  while IsObsRunning() do
  begin
    if MsgBox('OBS Studio is running.' + #13#10#13#10 +
              'Close OBS completely, then click Retry.' + #13#10#13#10 +
              'Installing while OBS is open leaves the previous plugin file locked, so the ' +
              'upgrade only half-applies - and OBS can end up loading two copies of the plugin, ' +
              'which fight over the relay connection.',
              mbError, MB_RETRYCANCEL) = IDCANCEL then
    begin
      Result := False;
      Exit;
    end;
  end;
end;

{ Runs once, after the wizard and with Setup already elevated, before any file is
  copied. Returning a non-empty string aborts the install and shows it. }
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  Paths: String;
  Choice: Integer;
begin
  Result := '';

  if InTreeCopies(Paths) = 0 then
    Exit;

  Choice := MsgBox('A copy of this plugin is also installed inside OBS''s own program folder:' +
                   #13#10#13#10 + Paths + #13#10 +
                   'OBS loads every plugin folder it finds. If that copy stays, OBS runs the ' +
                   'plugin twice - both feeds publish to the same relay path and knock each ' +
                   'other offline every few seconds.' + #13#10#13#10 +
                   'Remove it now?' + #13#10#13#10 +
                   'Yes - delete the files listed above, then install (recommended).' + #13#10 +
                   'No - leave them and install anyway.' + #13#10 +
                   'Cancel - stop, change nothing.',
                   mbConfirmation, MB_YESNOCANCEL);

  if Choice = IDCANCEL then
  begin
    Result := 'Installation cancelled so the copy in OBS''s program folder can be removed first.';
    Exit;
  end;

  if Choice = IDYES then
  begin
    if not DeleteInTreeCopies() then
      Result := 'Could not remove the copy in OBS''s program folder. Close OBS, then run this ' +
                'installer again - or delete those files by hand.';
  end;
end;
